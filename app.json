{
  "expo": {
    "name": "gilbert-pro",
    "slug": "gilbert-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_logo.jpeg",
    "scheme": "gilbertpro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blackcodeur2.gilbertpro",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "Cette application utilise la caméra",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_logo.jpeg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.blackcodeur2.gilbertpro"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app_logo.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app_logo.jpeg",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#FFFAF7"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5a4cdc61-4f68-451e-bae6-b97dffb19f2a"
      }
    }
  }
}
